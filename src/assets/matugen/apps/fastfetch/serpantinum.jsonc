{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logo.txt",
    "type": "file-raw",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "separator": "#e3e1e9"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{1}",
      "color": {
        "user": "#b6c4ff"
      }
    },
    "break",
    {
      "type": "os",
      "key": "󱄅 os  ",
      "keyColor": "#b6c4ff"
    },
    {
      "type": "kernel",
      "key": "󰒋 ker ",
      "keyColor": "#c2c5dd"
    },
    {
      "type": "uptime",
      "key": "󱑂 up  ",
      "keyColor": "#e3bada"
    },
    {
      "type": "packages",
      "key": "󰏖 pkg ",
      "keyColor": "#b6c4ff"
    },
    {
      "type": "shell",
      "key": " sh  ",
      "keyColor": "#4d5c92"
    },
    {
      "type": "wm",
      "key": " wm  ",
      "keyColor": "#b6c4ff"
    },
    {
      "type": "terminal",
      "key": " term",
      "keyColor": "#c2c5dd"
    },
    {
      "type": "cpu",
      "key": " cpu ",
      "keyColor": "#e3bada"
    },
    {
      "type": "gpu",
      "key": "󰢮 gpu ",
      "keyColor": "#b6c4ff"
    },
    {
      "type": "memory",
      "key": "󰘚 ram ",
      "keyColor": "#c2c5dd"
    },
    {
      "type": "battery",
      "key": "󰁹 bat ",
      "keyColor": "#e3bada"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
